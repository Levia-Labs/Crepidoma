# Anthropic API key for plugin agents run on API credits (task claude:api:run)
ANTHROPIC_API_KEY=
# Optional admin key (organization accounts) for the cost report
ANTHROPIC_ADMIN_KEY=
# Monthly credit grant in USD (default 200)
CREPIDOMA_API_CREDIT_USD=
# Billing cycle start YYYY-MM-DD (default first day of the current month)
CREPIDOMA_API_CYCLE_START=
# Refuse runs at or under this remaining USD (default 10)
CREPIDOMA_API_FLOOR_USD=
