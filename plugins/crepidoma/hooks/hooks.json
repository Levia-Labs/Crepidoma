{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"${CLAUDE_PLUGIN_ROOT}/scripts/inject_directives.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"${CLAUDE_PLUGIN_ROOT}/scripts/raw_read_guard.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks.py\" pre-bash"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"${CLAUDE_PLUGIN_ROOT}/scripts/rtk_route.py\""
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks.py\" pre-tool-use"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"${CLAUDE_PLUGIN_ROOT}/scripts/agent_pool.py\" hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks.py\" post-tool-use"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"${CLAUDE_PLUGIN_ROOT}/scripts/inject_directives.py\" --event SubagentStart"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks.py\" subagent-start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks.py\" subagent-stop"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks.py\" stop"
          }
        ]
      }
    ]
  }
}
